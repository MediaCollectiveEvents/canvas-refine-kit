                          name: withFades,
                          widget: boolean,
                          required: false,
                          default: true,
                        }

                  - { label: Description, name: description, widget: text }
                  - label: Logos
                    name: logos
                    widget: list
                    field: { label: Logo, name: logo, widget: string }

  # === ABOUT PAGE (about.json) ===
  - name: aboutPage
    label: About Page
    files:
      - name: about
        label: About Page Content
        file: "src/content/about.json"
        format: json
        fields:
          - label: "Hero"
            name: "hero"
            widget: "object"
            fields:
              - {
                  label: "Eyebrow",
                  name: "eyebrow",
                  widget: "string",
                  required: false,
                }
              - { label: "Title", name: "title", widget: "string" }
              - {
                  label: "Description",
                  name: "description",
                  widget: "text",
                  required: false,
                }

              # Hero image selection
              - label: "Hero Image Key"
                name: "imageKey"
                widget: "select"
                required: false
                
                  - { label: "Home Hero", value: "homeHero" }
                  - { label: "About Hero", value: "aboutHero" }
                  - { label: "Events Hero", value: "eventsHero" }
                  - { label: "Blog Hero", value: "blogHero" }
                  - { label: "FAQ Hero", value: "faqHero" }
                  - { label: "Partners Hero", value: "partnersHero" }
                  - { label: "Default Hero", value: "defaultHero" }

              - label: "Theme"
                name: "theme"
                widget: "select"
                
                  - { label: "Dark", value: "dark" }
                  - { label: "Light", value: "light" }
              - label: "Overlay Strength"
                name: "overlayStrength"
                widget: "number"
                value_type: "float"
                min: 0
                max: 1
                step: 0.05
              - label: "Primary CTA"
                name: "primaryCta"
                widget: "object"
                required: false
                fields:
                  - {
                      label: "Label",
                      name: "label",
                      widget: "string",
                      required: false,
                    }

          - label: "Sections"
            name: "sections"
            widget: "list"
            types:
              - label: "About Intro"
                name: "aboutIntro"
                widget: "object"
                fields:
                  - { label: "ID", name: "id", widget: "string" }
                  - {
                      label: "Type",
                      name: "type",
                      widget: "hidden",
                      default: "aboutIntro",
                    }
                  - {
                      label: "Hidden",
                      name: "hidden",
                      widget: "boolean",
                      default: false,
                    }
                  - { label: "Title", name: "title", widget: "string" }
                  - {
                      label: "Accent Word",
                      name: "accentWord",
                      widget: "string",
                      required: false,
                    }
                  - { label: "Body", name: "body", widget: "text" }
                  - label: "CTA"
                    name: "cta"
                    widget: "object"
                    required: false
                    fields:
                      - {
                          label: "Label",
                          name: "label",
                          widget: "string",
                          required: false,
                        }

              - label: "Story Section"
                name: "story"
                widget: "object"
                fields:
                  - { label: "ID", name: "id", widget: "string" }
                  - {
                      label: "Type",
                      name: "type",
                      widget: "hidden",
                      default: "story",
                    }
                  - {
                      label: "Hidden",
                      name: "hidden",
                      widget: "boolean",
                      default: false,
                    }
                  - { label: "Title", name: "title", widget: "string" }
                  - {
                      label: "Accent Word",
                      name: "accentWord",
                      widget: "string",
                      required: false,
                    }
                  - { label: "Body", name: "body", widget: "text" }

              - label: "Mission & Values"
                name: "missionValues"
                widget: "object"
                fields:
                  - { label: "ID", name: "id", widget: "string" }
                  - {
                      label: "Type",
                      name: "type",
                      widget: "hidden",
                      default: "missionValues",
                    }
                  - {
                      label: "Hidden",
                      name: "hidden",
                      widget: "boolean",
                      default: false,
                    }
                  - { label: "Title", name: "title", widget: "string" }
                  - {
                      label: "Accent Word",
                      name: "accentWord",
                      widget: "string",
                      required: false,
                    }
                  - {
                      label: "Description",
                      name: "description",
                      widget: "text",
                    }
                  - label: "Values"
                    name: "values"
                    widget: "list"
                    fields:
                      - { label: "Icon Key", name: "icon", widget: "string" }
                      - { label: "Title", name: "title", widget: "string" }
                      - {
                          label: "Description",
                          name: "description",
                          widget: "text",
                        }
                      - {
                          label: "Color Class",
                          name: "color",
                          widget: "string",
                          required: false,
                        }
                      - {
                          label: "BG Class",
                          name: "bgColor",
                          widget: "string",
                          required: false,
                        }

              - label: "Join Us"
                name: "joinUs"
                widget: "object"
                fields:
                  - { label: "ID", name: "id", widget: "string" }
                  - {
                      label: "Type",
                      name: "type",
                      widget: "hidden",
                      default: "joinUs",
                    }
                  - {
                      label: "Hidden",
                      name: "hidden",
                      widget: "boolean",
                      default: false,
                    }
                  - { label: "Title", name: "title", widget: "string" }
                  - {
                      label: "Accent Word",
                      name: "accentWord",
                      widget: "string",
                      required: false,
                    }
                  - { label: "Body", name: "body", widget: "text" }
                  - label: "CTA"
                    name: "cta"
                    widget: "object"
                    fields:
                      - { label: "Label", name: "label", widget: "string" }
                      - {
                          label: "URL",
                          name: "url",
                          widget: "string",
                          required: false,
                        }

  # === FAQ PAGE (faqPage.json) ===
  - name: faqPage
    label: FAQ Page
    files:
      - name: faqPage
        label: FAQ Page Content
        file: "src/content/faqPage.json"
        format: json
        fields:
          - label: "Hero"
            name: "hero"
            widget: "object"
            fields:
              - {
                  label: "Eyebrow",
                  name: "eyebrow",
                  widget: "string",
                  required: false,
                }
              - { label: "Title", name: "title", widget: "string" }
              - {
                  label: "Description",
                  name: "description",
                  widget: "text",
                  required: false,
                }

              # Hero image selection
              - label: "Hero Image Key"
                name: "imageKey"
                widget: "select"
                required: false
                
                  - { label: "Home Hero", value: "homeHero" }
                  - { label: "About Hero", value: "aboutHero" }
                  - { label: "Events Hero", value: "eventsHero" }
                  - { label: "Blog Hero", value: "blogHero" }
                  - { label: "FAQ Hero", value: "faqHero" }
                  - { label: "Partners Hero", value: "partnersHero" }
                  - { label: "Default Hero", value: "defaultHero" }

              - label: "Theme"
                name: "theme"
                widget: "select"
                
                  - { label: "Dark", value: "dark" }
                  - { label: "Light", value: "light" }
              - label: "Variant"
                name: "variant"
                widget: "select"
                required: false
                
                  - { label: "Solid", value: "solid" }
                  - { label: "Image", value: "image" }
              - label: "Align"
                name: "align"
                widget: "select"
                required: false
                
                  - { label: "Center", value: "center" }
                  - { label: "Left", value: "left" }

          - label: "Sections"
            name: "sections"
            widget: "list"
            summary: "{{fields.type}} — {{fields.title}}"
            fields:
              - { label: "ID", name: "id", widget: "string", required: false }

              - label: "Type"
                name: "type"
                widget: "select"
                
                  - { label: FAQ Section, value: faqSection }
                  - { label: Call to Action, value: cta }

              - {
                  label: "Hidden",
                  name: "hidden",
                  widget: "boolean",
                  required: false,
                  default: false,
                }

              - label: "Variant"
                name: "variant"
                widget: "select"
                required: false
                
                  - { label: Default, value: default }
                  - { label: Darker, value: darker }
                  - { label: Accent, value: accent }

              # Shared fields
              - {
                  label: "Title",
                  name: "title",
                  widget: "string",
                  required: false,
                }
              - {
                  label: "Accent Word",
                  name: "accentWord",
                  widget: "string",
                  required: false,
                }
              - {
                  label: "Description",
                  name: "description",
                  widget: "text",
                  required: false,
                }

              # CTA-only
              - {
                  label: "Button Label",
                  name: "buttonLabel",
                  widget: "string",
                  required: false,
                }

  # === EVENTS CONTENT (events.json) ===
  - name: events
    label: Events
    files:
      - name: eventsContent
        label: Events Content
        file: "src/content/events.json"
        format: json
        fields:
          # HERO (used at top of Events page)
          - label: Hero
            name: hero
            widget: object
            fields:
              - {
                  label: Eyebrow,
                  name: eyebrow,
                  widget: string,
                  required: false,
                }
              - { label: Title, name: title, widget: string }
              - {
                  label: Description,
                  name: description,
                  widget: text,
                  required: false,
                  hint: "Short one‑ or two‑sentence summary shown in the hero.",
                }

              # Hero image selection
              - label: Hero Image Key
                name: image
                widget: image
                required: false
                
                  - { label: Home Hero, value: homeHero }
                  - { label: About Hero, value: aboutHero }
                  - { label: Events Hero, value: eventsHero }
                  - { label: Blog Hero, value: blogHero }
                  - { label: FAQ Hero, value: faqHero }
                  - { label: Partners Hero, value: partnersHero }
                  - { label: Default Hero, value: defaultHero }

              - label: Theme
                name: theme
                widget: image
                required: false
                default: dark
                
                  - { label: Dark, value: dark }
                  - { label: Light, value: light }
              - label: Overlay Strength
                name: overlayStrength
                widget: number
                required: false
                value_type: float
                min: 0
                max: 1
                step: 0.05
                default: 0.5

          # INTRO SECTION
          - label: Intro Section
            name: intro
            widget: object
            required: false
            fields:
              - { label: Title, name: title, widget: string, required: false }
              - { label: Body, name: body, widget: text, required: false }

          # EVENTS LIST
          - label: Events
            name: events
            widget: list
            allow_add: true
            fields:
              - { label: Title, name: title, widget: string }
              - { label: Location, name: location, widget: string }
              - { label: Venue, name: venue, widget: string }
              - label: Date
                name: date
                widget: date
                format: "YYYY-MM-DD"
                required: true
              - { label: Time, name: time, widget: string, required: false }
              - label: Type
                name: type
                widget: image
                
                  - { label: Upcoming, value: upcoming }
                  - { label: Past, value: past }
                default: upcoming
              - label: Show on Homepage
                name: showOnHomepage
                widget: boolean
                required: false
                default: true
              - label: Image Key
                name: image
                widget: image
                required: false
                
                  - { label: Broadcaster, value: broadcaster }
                  - { label: Hand and Flower, value: handandflower }
                  - { label: Traveller, value: traveller }
              - {
                  label: Short Description,
                  name: description,
                  widget: text,
                  required: true,
                }
              - {
                  label: Full Details,
                  name: details,
                  widget: text,
                  required: false,
                }
              - {
                  label: ID (optional),
                  name: id,
                  widget: number,
                  required: false,
                }
  - name: sponsors
    label: Sponsor Logos
    files:
      - name: sponsors
        label: Sponsor Logos
        file: "src/content/sponsors.json"
        format: json
        fields:
          - label: Logos
            name: logos
            widget: list
            allow_add: true
            fields:
              - { label: Logo Image, name: src, widget: image }
              - { label: Alt Text, name: alt, widget: string, required: false }
                            
  # === BLOG PAGE (blogPage.json) ===
  - name: blogPage
    label: Blog Page
    files:
      - name: blogPage
        label: Blog Page Content
        file: "src/content/blogPage.json"
        format: json
        fields:
          - label: Hero
            name: hero
            widget: object
            fields:
              - {
                  label: Eyebrow,
                  name: eyebrow,
                  widget: string,
                  required: false,
                }
              - { label: Title, name: title, widget: string }
              - {
                  label: Description,
                  name: description,
                  widget: text,
                  required: false,
                }

              # Hero image key (from heroImageMap)
              - label: Hero Image Key
                name: image
                widget: image
                required: false
                
                  - { label: Home Hero, value: homeHero }
                  - { label: About Hero, value: aboutHero }
                  - { label: Events Hero, value: eventsHero }
                  - { label: Blog Hero, value: blogHero }
                  - { label: FAQ Hero, value: faqHero }
                  - { label: Partners Hero, value: partnersHero }
                  - { label: Default Hero, value: defaultHero }

              - label: Theme
                name: theme
                widget: image
                
                  - { label: Dark, value: dark }
                  - { label: Light, value: light }

              - label: Overlay Strength
                name: overlayStrength
                widget: number
                value_type: float
                min: 0
                max: 1
                step: 0.05
                default: 0.5

          - label: Intro
            name: intro
            widget: object
            required: false
            fields:
              - {
                  label: Heading,
                  name: heading,
                  widget: string,
                  required: false,
                }
              - { label: Body, name: body, widget: text, required: false }

  # === BLOG POSTS (blogPosts.json) ===
  - name: blogPosts
    label: Blog Posts
    files:
      - name: blogPosts
        label: Blog Posts
        file: "src/content/blogPosts.json"
        format: json
        fields:
          - label: Posts
            name: posts
            widget: list
            allow_add: true
            collapsed: false
            fields:
              - { label: Title, name: title, widget: string }
              - { label: Slug, name: slug, widget: string }
              - { label: Category, name: category, widget: string }
              - { label: Excerpt, name: excerpt, widget: text }
              - { label: Date, name: date, widget: datetime }
              - { label: Image, name: image, widget: image, required: false }

  # === PARTNERS PAGE (partners.json) ===
  - name: partnersPage
    label: Partners Page
    files:
      - name: partnersPage
        label: Partners Page Content
        file: "src/content/partners.json"
        format: json
        fields:
          # HERO
          - label: Hero
            name: hero
            widget: object
            fields:
              - {
                  label: Eyebrow,
                  name: eyebrow,
                  widget: string,
                  required: false,
                }
              - { label: Title, name: title, widget: string }
              - {
                  label: Description,
                  name: description,
                  widget: text,
                  required: false,
                }

              # Hero image selection
              - label: Hero Image Key
                name: image
                widget: image
                required: false
                
                  - { label: Home Hero, value: homeHero }
                  - { label: About Hero, value: aboutHero }
                  - { label: Events Hero, value: eventsHero }
                  - { label: Blog Hero, value: blogHero }
                  - { label: FAQ Hero, value: faqHero }
                  - { label: Partners Hero, value: partnersHero }
                  - { label: Default Hero, value: defaultHero }

              - label: Theme
                name: theme
                widget: image
                required: false
                default: dark
                
                  - { label: Dark, value: dark }
                  - { label: Light, value: light }
              - label: Overlay Strength
                name: overlayStrength
                widget: number
                required: false
                value_type: float
                min: 0
                max: 1
                step: 0.05
                default: 0.5
              - label: Primary CTA
                name: primaryCta
                widget: object
                required: false
                fields:
                  - { label: Label, name: label, widget: string }
                  - { label: URL, name: url, widget: string }

          # SECTIONS
          - label: Sections
            name: sections
            widget: list
            fields:
              - { label: ID, name: id, widget: string }
              - label: Type
                name: type
                widget: image
                
                  - { label: Partners Logos, value: partnersLogos }
                  - { label: Partners Benefits, value: partnersBenefits }
                  - { label: Partners Tiers, value: partnersTiers }
                  - { label: Join Us CTA, value: joinUs }
              - { label: Hidden, name: hidden, widget: boolean, default: false }

  # === SITE SETTINGS (navigation, palette, footer) ===
  - name: settings
    label: Site Settings
    files:
      - name: settings
        label: Site Settings
        file: "src/content/settings.json"
        format: json
        fields:
          - label: Palette
            name: palette
            widget: object
            fields:
              - { label: Primary, name: primary, widget: string }
              - { label: Secondary, name: secondary, widget: string }
              - { label: Background, name: background, widget: string }

          - label: Footer
            name: footer
            widget: object
            fields:
              - { label: Text, name: text, widget: text, required: false }
              - {
                  label: Show Events in Footer,
                  name: showEventsInFooter,
                  widget: boolean,
                  required: false,
                  default: false,
                }

          - label: Navigation
            name: nav
            widget: list
            summary: "{{fields.label}} → {{fields.type}}"
            fields:
              - { label: Label, name: label, widget: string }
              - label: Link Type
                name: type
                widget: image
                
                  - { label: Home, value: home }
                  - { label: About, value: about }
                  - { label: Events, value: events }
                  - { label: Blog, value: blog }
                  - { label: Partners, value: partners }
                  - { label: FAQ, value: faq }
              - {
                  label: URL Override (optional),
                  name: url,
                  widget: string,
                  required: false,
                  hint: "Override the default route if needed.",
                }
