local_backend: true

backend:
  name: github
  repo: MediaCollectiveEvents/canvas-refine-kit
  branch: minviableproduct

media_folder: "public/uploads"
public_folder: "/uploads"

collections:
  # === HOMEPAGE CONTENT (homepage.json) ===
  - name: homepage
    label: Homepage
    files:
      - name: homepage
        label: Homepage Content
        file: "src/content/homepage.json"
        format: json
        fields:
          # HERO
          - label: Hero
            name: hero
            widget: object
            fields:
              - { label: Title, name: title, widget: string }
              - { label: Subtitle, name: subtitle, widget: string }
              - { label: Description, name: description, widget: text }

              # Hero image selection (matches heroImageMap keys)
              - label: Hero Image Key
                name: image
                widget: image
                required: false
                
                  - { label: Home Hero, value: homeHero }
                  - { label: About Hero, value: aboutHero }
                  - { label: Events Hero, value: eventsHero }
                  - { label: Blog Hero, value: blogHero }
                  - { label: FAQ Hero, value: faqHero }
                  - { label: Partners Hero, value: partnersHero }
                  - { label: Default Hero, value: defaultHero }

              # Theme toggle
              - label: Hero Theme
                name: theme
                widget: image
                default: dark
                
                  - { label: "Dark", value: "dark" }
                  - { label: "Light", value: "light" }

              # Overlay strength control
              - label: Hero Overlay Strength
                name: overlayStrength
                widget: image
                default: 0.5
                
                  - { label: "0 (Off)", value: 0 }
                  - { label: "0.25 (Brightest)", value: 0.25 }
                  - { label: "0.5 (Bright & Balanced)", value: 0.5 }
                  - { label: "0.75 (More Contrast)", value: 0.75 }
                  - { label: "1 (Max Contrast)", value: 1 }

              - label: Primary CTA
                name: primaryCta
                widget: object
                required: false
                fields:
                  - { label: Label, name: label, widget: string }
                  - { label: URL, name: url, widget: string }
              - label: Secondary CTA
                name: secondaryCta
                widget: object
                required: false
                fields:
                  - { label: Label, name: label, widget: string }
                  - { label: URL, name: url, widget: string }

          # SECTIONS
          - label: Sections
            name: sections
            widget: list
            types:
              # JOIN COMMUNITY
              - label: Join Community
                name: joinCommunity
                widget: object
                fields:
                  - {
                      label: Type,
                      name: type,
                      widget: hidden,
                      default: "joinCommunity",
                    }
                  - { label: Heading, name: heading, widget: string }
                  - {
                      label: Hidden,
                      name: hidden,
                      widget: boolean,
                      required: false,
                      default: false,
                    }

                  # --- Title Styling ---
                  - label: Title Styling
                    name: styleTitle
                    widget: object
                    required: false
                    fields:
                      - {
                          label: Eyebrow (optional),
                          name: eyebrow,
                          widget: string,
                          required: false,
                        }
                      - {
                          label: Subline (optional),
                          name: sub,
                          widget: string,
                          required: false,
                        }
                      - label: Align
                        name: align
                        widget: image
                        required: false
                        default: center
                        
                          - { label: Center, value: center }
                          - { label: Left, value: left }
                          - { label: Right, value: right }
                      - label: Tone
                        name: tone
                        widget: image
                        required: false
                        default: default
                        
                          - { label: Default, value: default }
                          - { label: Muted, value: muted }
                      - {
                          label: Disable Italic Emphasis,
                          name: disableEmphasis,
                          widget: boolean,
                          required: false,
                          default: false,
                        }

                  # --- Section Surface ---
                  - label: Section Surface
                    name: styleWrapper
                    widget: object
                    required: false
                    fields:
                      - label: Variant
                        name: variant
                        widget: image
                        required: false
                        default: glow
                        
                          - { label: Clean, value: clean }
                          - { label: Tint, value: tint }
                          - { label: Glow, value: glow }
                      - label: Padding
                        name: padding
                        widget: image
                        required: false
                        default: lux
                        
                          - { label: Lux (spacious), value: lux }
                          - { label: Regular, value: regular }
                      - {
                          label: Micro noise texture,
                          name: noise,
                          widget: boolean,
                          required: false,
                          default: false,
                        }
                      - {
                          label: Micro grid overlay,
                          name: grid,
                          widget: boolean,
                          required: false,
                          default: false,
                        }
                      - {
                          label: Soft top/bottom fades,
                          name: withFades,
                          widget: boolean,
                          required: false,
                          default: true,
                        }

                  - { label: Body, name: body, widget: text }
                  - label: CTA
                    name: cta
                    widget: object
                    required: false
                    fields:
                      - { label: Label, name: label, widget: string }
                      - { label: URL, name: url, widget: string }

              # ABOUT INTRO
              - label: About Intro
                name: aboutIntro
                widget: object
                fields:
                  - {
                      label: Type,
                      name: type,
                      widget: hidden,
                      default: "aboutIntro",
                    }
                  - { label: Heading, name: heading, widget: string }
                  - {
                      label: Hidden,
                      name: hidden,
                      widget: boolean,
                      required: false,
                      default: false,
                    }

                  # --- Title Styling ---
                  - label: Title Styling
                    name: styleTitle
                    widget: object
                    required: false
                    fields:
                      - {
                          label: Eyebrow (optional),
                          name: eyebrow,
                          widget: string,
                          required: false,
                        }
                      - {
                          label: Subline (optional),
                          name: sub,
                          widget: string,
                          required: false,
                        }
                      - label: Align
                        name: align
                        widget: image
                        required: false
                        default: center
                        
                          - { label: Center, value: center }
                          - { label: Left, value: left }
                          - { label: Right, value: right }
                      - label: Tone
                        name: tone
                        widget: image
                        required: false
                        default: default
                        
                          - { label: Default, value: default }
                          - { label: Muted, value: muted }
                      - {
                          label: Disable Italic Emphasis,
                          name: disableEmphasis,
                          widget: boolean,
                          required: false,
                          default: false,
                        }

                  # --- Section Surface ---
                  - label: Section Surface
                    name: styleWrapper
                    widget: object
                    required: false
                    fields:
                      - label: Variant
                        name: variant
                        widget: image
                        required: false
                        default: clean
                        
                          - { label: Clean, value: clean }
                          - { label: Tint, value: tint }
                          - { label: Glow, value: glow }
                      - label: Padding
                        name: padding
                        widget: image
                        required: false
                        default: lux
                        
                          - { label: Lux (spacious), value: lux }
                          - { label: Regular, value: regular }
                      - {
                          label: Micro noise texture,
                          name: noise,
                          widget: boolean,
                          required: false,
                          default: false,
                        }
                      - {
                          label: Micro grid overlay,
                          name: grid,
                          widget: boolean,
                          required: false,
                          default: false,
                        }
                      - {
                          label: Soft top/bottom fades,
                          name: withFades,
                          widget: boolean,
                          required: false,
                          default: true,
                        }

                  - { label: Body, name: body, widget: text }
                  - { label: Extended Text, name: extended, widget: text }

              # WHO ATTENDS
              - label: Who Attends
                name: whoAttends
                widget: object
                fields:
                  - {
                      label: Type,
                      name: type,
                      widget: hidden,
                      default: "whoAttends",
                    }
                  - { label: Heading, name: heading, widget: string }
                  - {
                      label: Hidden,
                      name: hidden,
                      widget: boolean,
                      required: false,
                      default: false,
                    }

                  # --- Title Styling ---
                  - label: Title Styling
                    name: styleTitle
                    widget: object
                    required: false
                    fields:
                      - {
                          label: Eyebrow (optional),
                          name: eyebrow,
                          widget: string,
                          required: false,
                        }
                      - {
                          label: Subline (optional),
                          name: sub,
                          widget: string,
                          required: false,
                        }
                      - label: Align
                        name: align
                        widget: image
                        required: false
                        default: center
                        
                          - { label: Center, value: center }
                          - { label: Left, value: left }
                          - { label: Right, value: right }
                      - label: Tone
                        name: tone
                        widget: image
                        required: false
                        default: default
                        
                          - { label: Default, value: default }
                          - { label: Muted, value: muted }
                      - {
                          label: Disable Italic Emphasis,
                          name: disableEmphasis,
                          widget: boolean,
                          required: false,
                          default: false,
                        }

                  # --- Section Surface ---
                  - label: Section Surface
                    name: styleWrapper
                    widget: object
                    required: false
                    fields:
                      - label: Variant
                        name: variant
                        widget: image
                        required: false
                        default: tint
                        
                          - { label: Clean, value: clean }
                          - { label: Tint, value: tint }
                          - { label: Glow, value: glow }
                      - label: Padding
                        name: padding
                        widget: image
                        required: false
                        default: lux
                        
                          - { label: Lux (spacious), value: lux }
                          - { label: Regular, value: regular }
                      - {
                          label: Micro noise texture,
                          name: noise,
                          widget: boolean,
                          required: false,
                          default: false,
                        }
                      - {
                          label: Micro grid overlay,
                          name: grid,
                          widget: boolean,
                          required: false,
                          default: false,
                        }
                      - {
                          label: Soft top/bottom fades,
                          name: withFades,
                          widget: boolean,
                          required: false,
                          default: true,
                        }

                  - label: Statistics
                    name: statistics
                    widget: object
                    fields:
                      - { label: Companies, name: companies, widget: string }
                      - { label: Board Level, name: boardLevel, widget: string }
                      - { label: Founders, name: founders, widget: string }

                  - label: Highlights
                    name: highlights
                    widget: list
                    allow_add: true
                    fields:
                      - { label: Title, name: title, widget: string }
                      - { label: Subtitle, name: subtitle, widget: string }
                      - label: Icon
                        name: icon
                        widget: image
                        
                          - { label: Globe, value: globe }
                          - { label: Film, value: film }
                          - { label: Play, value: play }

              # UPCOMING EVENTS INTRO
              - label: Upcoming Events Intro
                name: upcomingEventsIntro
