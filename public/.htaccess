# Generated by scripts/generate-apache-routing.mjs from canonicalRoutes.mjs.
# Requires Apache 2.4 mod_rewrite and AllowOverride FileInfo.
ErrorDocument 404 /seo-pages/404.html
RewriteEngine On
RewriteBase /

# Match Home before the existing-directory bypass. Queries are retained.
RewriteRule ^$ /seo-pages/home.html [END,NC]
RewriteRule ^events/?$ /seo-pages/events.html [END,NC]
RewriteRule ^community/?$ /seo-pages/community.html [END,NC]
RewriteRule ^partners/?$ /seo-pages/partners.html [END,NC]
RewriteRule ^faq/?$ /seo-pages/faq.html [END,NC]
RewriteRule ^privacy-policy/?$ /seo-pages/privacy-policy.html [END,NC]
RewriteRule ^events/1/?$ /seo-pages/event-1.html [END,NC]
RewriteRule ^events/2/?$ /seo-pages/event-2.html [END,NC]
RewriteRule ^events/3/?$ /seo-pages/event-3.html [END,NC]
RewriteRule ^events/4/?$ /seo-pages/event-4.html [END,NC]
RewriteRule ^events/5/?$ /seo-pages/event-5.html [END,NC]
RewriteRule ^events/6/?$ /seo-pages/event-6.html [END,NC]
RewriteRule ^events/7/?$ /seo-pages/event-7.html [END,NC]
RewriteRule ^events/8/?$ /seo-pages/event-8.html [END,NC]

# Existing React compatibility redirects and the Decap launcher remain client-side.
RewriteRule ^(?:about|events/calendar|blog(?:/[^/]+)?|manage)/?$ /index.html [END,NC]

# Leave real assets and directories (including /admin/) to Apache.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# A local ErrorDocument preserves both the requested URL and the 404 status.
RewriteRule ^ - [R=404,END]
